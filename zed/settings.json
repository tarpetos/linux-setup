// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left",
    "folder_indicator": "both",
    "auto_fold_dirs": false,
    "git_status": true,
    "indent_size": 16
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "base_keymap": "JetBrains",
  // Reopen the projects from the last session, like PyCharm
  "restore_on_startup": "last_session",

  // PyCharm-like look
  "auto_install_extensions": {
    "jetbrains-themes": true,
    "jetbrains-new-ui-icons": true
  },
  "theme": {
    "mode": "dark",
    "light": "JetBrains Islands Light",
    "dark": "JetBrains Islands Dark"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "JetBrains New UI Icons (Light)",
    "dark": "JetBrains New UI Icons (Dark)"
  },
  "ui_font_family": "Inter",
  "ui_font_size": 15,
  "text_rendering_mode": "subpixel",
  "bottom_dock_layout": "full",
  // Terminal palette sampled from PyCharm's terminal
  "theme_overrides": {
    "JetBrains Islands Dark": {
      "terminal.foreground": "#dfe1e5",
      "terminal.bright_foreground": "#ffffff",
      // PyCharm colors gitignored entries orange instead of dimming them
      "version_control.ignored": "#d69a6b",
      "ignored": "#d69a6b",
      "terminal.ansi.black": "#000000",
      "terminal.ansi.blue": "#245980",
      "terminal.ansi.green": "#39511f"
    }
  },
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 13.5,
  "buffer_line_height": { "custom": 1.65 },
  // Defaults plus the cache/IDE folders PyCharm hides
  "file_scan_exclusions": [
    "**/.git", "**/.svn", "**/.hg", "**/.jj", "**/.sl", "**/.repo", "**/CVS",
    "**/.DS_Store", "**/Thumbs.db", "**/.classpath", "**/.settings",
    "**/.idea", "**/.pytest_cache", "**/.ruff_cache", "**/__pycache__"
  ],
  "preferred_line_length": 120,
  "wrap_guides": [120],

  "terminal": {
    "font_family": "JetBrains Mono",
    "font_size": 13,
    "line_height": "standard",
    // keep black text black on colored prompt segments, like PyCharm
    "minimum_contrast": 0,
    // .venv is activated by auto-venv.zsh; Zed's own activation would run it twice
    "detect_venv": "off"
  },

  // Windows only: terminal opens the default WSL distro
  "windows": {
    "terminal": {
      "shell": {
        "program": "wsl.exe"
      }
    }
  }
}
